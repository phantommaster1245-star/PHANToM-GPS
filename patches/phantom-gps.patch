+package io.github.phantom.gps.utils
+
+import android.app.Activity
+import android.content.Context
+import android.os.SystemClock
+import android.widget.CheckBox
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import androidx.appcompat.app.AlertDialog
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.time.Instant
+import java.time.ZoneId
+
+object MembershipDisplay {
+    private var dialog:AlertDialog?=null
+    private var owner:Activity?=null
+    private fun now(c:Context):Long? {
+        if (!MembershipLease.valid(c)) return null
+        val p=MembershipLease.verifier.inspect(PrefManager.membershipLease)?:return null
+        return p.issuedAt + (SystemClock.elapsedRealtime()-p.anchor)
+    }
+    private fun duration(ms:Long):String {
+        val minutes=(ms.coerceAtLeast(0)+59999)/60000
+        return "${minutes/1440} วัน ${(minutes%1440)/60} ชม. ${minutes%60} นาที"
+    }
+    private fun date(ms:Long)=SimpleDateFormat("d MMM yyyy HH:mm",Locale("th","TH")).format(Date(ms))
+    data class Header(val username:String,val remaining:String,val expiry:String)
+    fun header(c:Context):Header {
+        val user=MembershipAccount.username(c).ifBlank { "GeoX" }
+        val time=now(c)?:return Header(user,"กำลังตรวจสอบสิทธิ์…",MembershipAccount.expiresAt(c).takeIf { it>0 }?.let { "สิ้นสุด ${date(it)}" }.orEmpty())
+        val expiry=MembershipAccount.expiresAt(c)
+        return Header(user,"คงเหลือ ${duration(expiry-time)}","สิ้นสุด ${date(expiry)}")
+    }
+    fun maybeRemind(activity:Activity) {
+        if(activity.isFinishing||activity.isDestroyed||dialog?.isShowing==true)return
+        val time=now(activity)?:return
+        val expiry=MembershipAccount.expiresAt(activity)
+        val p=activity.getSharedPreferences("geox_expiry_reminder",Context.MODE_PRIVATE)
+        val key=MembershipAccount.username(activity)
+        val day=Instant.ofEpochMilli(time).atZone(ZoneId.systemDefault()).toLocalDate().toString()
+        val sameDay=p.getString("$key.day","")==day
+        val count=if(sameDay)p.getInt("$key.count",0) else 0
+        if(!ExpiryReminderPolicy.shouldShow(expiry-time,time,count,p.getLong("$key.last",0),sameDay&&p.getBoolean("$key.suppressed",false)))return
+        val check=CheckBox(activity).apply { text="ไม่แสดงอีกในวันนี้";setPadding(24,16,24,16) }
+        owner=activity
+        dialog=MaterialAlertDialogBuilder(activity,io.github.phantom.gps.R.style.ThemeOverlay_GeoX_Dialog).setTitle("เวลาการใช้งานเหลือน้อยแล้ว")
+            .setMessage("เวลาคงเหลือ ${duration(expiry-time)}\nสิ้นสุด ${date(expiry)}\nติดต่อแอดมินเพื่อต่ออายุได้")
+            .setView(check).setPositiveButton("ปิด") {_,_->
+                if(check.isChecked)p.edit().putString("$key.day",day).putBoolean("$key.suppressed",true).apply()
+            }.create().also { d->d.setOnDismissListener { dialog=null;owner=null };d.show() }
+        p.edit().putString("$key.day",day).putInt("$key.count",count+1).putLong("$key.last",time).putBoolean("$key.suppressed",false).apply()
+    }
+    fun dismiss(activity:Activity) { if(owner===activity)dialog?.dismiss() }
+}
