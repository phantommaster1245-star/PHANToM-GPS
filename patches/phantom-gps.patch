+package io.github.phantom.gps.ui
+
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.view.View
+import android.widget.*
+import androidx.activity.viewModels
+import androidx.appcompat.app.AppCompatActivity
+import io.github.phantom.gps.BuildConfig
+import io.github.phantom.gps.R
+import io.github.phantom.gps.utils.*
+import java.text.SimpleDateFormat
+import java.util.*
+
+/** Membership sign-in; no activation code input or legacy code submission. */
+class ActivationActivity:AppCompatActivity() {
+    private val model:MembershipLoginViewModel by viewModels()
+    override fun onCreate(savedInstanceState:Bundle?) {
+        super.onCreate(savedInstanceState)
+        if(!AppIntegrity.isSelfValid(this)){finish();return}
+        setContentView(R.layout.activity_member_login)
+        val username=findViewById<EditText>(R.id.memberUsername)
+        val password=findViewById<EditText>(R.id.memberPassword)
+        val login=findViewById<Button>(R.id.memberLogin)
+        val progress=findViewById<ProgressBar>(R.id.memberProgress)
+        val error=findViewById<TextView>(R.id.memberError)
+        val status=findViewById<TextView>(R.id.memberStatus)
+        val logout=findViewById<Button>(R.id.memberLogout)
+        val rememberedStore=RememberedLoginStore(this)
+        val remember=findViewById<CheckBox>(R.id.memberRemember)
+        val forget=findViewById<Button>(R.id.memberForget)
+        remember.isChecked=rememberedStore.isEnabled()
+        val remembered=rememberedStore.read()
+        if(savedInstanceState==null){
+            username.setText(remembered?.username?:MembershipAccount.username(this))
+            if(remembered!=null)password.setText(remembered.password)
+        }
+        forget.visibility=if(remembered!=null)View.VISIBLE else View.GONE
+        remember.setOnCheckedChangeListener {_,checked->
+            runCatching{rememberedStore.setEnabled(checked)}.onFailure{Toast.makeText(this,"บันทึกตัวเลือกไม่สำเร็จ กรุณาลองใหม่",Toast.LENGTH_LONG).show()}
+            if(!checked)forget.visibility=View.GONE
+        }
+        forget.setOnClickListener {
+            runCatching{rememberedStore.forget()}.onSuccess{remember.isChecked=false;username.text?.clear();password.text?.clear();forget.visibility=View.GONE}
+                .onFailure{Toast.makeText(this,"ลืมบัญชีไม่สำเร็จ กรุณาลองใหม่",Toast.LENGTH_LONG).show()}
+        }
+        val showAccount=intent.getBooleanExtra("show_account",false)
+        if(MembershipAccount.isSignedIn(this)) {
+            val expiry=SimpleDateFormat("d MMM yyyy HH:mm",Locale("th","TH")).format(Date(MembershipAccount.expiresAt(this)))
+            status.text="บัญชี ${MembershipAccount.username(this)}\nใช้ได้ถึง $expiry"
+            logout.visibility=View.VISIBLE
+        }
+        logout.setOnClickListener {
+            if(runCatching{rememberedStore.forget()}.isFailure){Toast.makeText(this,"ลืมบัญชีไม่สำเร็จ กรุณาลองใหม่",Toast.LENGTH_LONG).show();return@setOnClickListener}
+            LicenseGuard.clearLicenseAndDeactivate(this);recreate()
+        }
+        findViewById<Button>(R.id.memberRegister).setOnClickListener {
+            runCatching{startActivity(Intent(Intent.ACTION_VIEW,Uri.parse(BuildConfig.PUBLIC_SITE_BASE_URL+"register.html")))}
+        }
+        login.setOnClickListener {model.login(username.text.toString(),password.text.toString(),remember.isChecked)}
+        model.uiState.observe(this){s->
+            progress.visibility=if(s.busy)View.VISIBLE else View.GONE
+            login.visibility=if(s.busy)View.GONE else View.VISIBLE
+            username.isEnabled=!s.busy;password.isEnabled=!s.busy;logout.isEnabled=!s.busy;remember.isEnabled=!s.busy;forget.isEnabled=!s.busy
+            error.text=s.error;error.visibility=if(s.error.isEmpty())View.GONE else View.VISIBLE
+            if(s.success){password.text?.clear();if(s.notice.isNotBlank())Toast.makeText(this,s.notice,Toast.LENGTH_LONG).show();startActivity(Intent(this,MapActivity::class.java));finish()}
+        }
+        if(!showAccount)model.checkExisting()
+    }
+    companion object {const val EXTRA_ACTIVATION_CODE="io.github.phantom.gps.extra.ACTIVATION_CODE"}
+}
