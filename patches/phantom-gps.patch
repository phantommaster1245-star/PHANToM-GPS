index 0000000000000000000000000000000000000000..5a3ccc4e2b9dbcae52137d0a524974606bc924fb
--- /dev/null
+++ b/app/src/main/res/layout/activity_member_login.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#101416">
+<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp">
+<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GeoX" android:textSize="30sp" android:textStyle="bold" android:textColor="#C7F568" />
+<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="YOUR LOCATION. YOUR CONTROL." android:textSize="12sp" android:textColor="#C7F568" />
+<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="GeoX — เดิม PHANToM GPS" android:textSize="13sp" android:textColor="#9AA8A3" />
+<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="เข้าสู่ระบบสมาชิก
+เริ่มสิทธิ์ 7 วันเมื่อเข้าแอปครั้งแรก ต่ออายุผ่านแอดมิน" android:textSize="16sp" android:textColor="#EFF5F0" />
+<TextView android:id="@+id/memberStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#8AE6C3" />
+<EditText android:id="@+id/memberUsername" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:hint="ชื่อผู้ใช้ หรือ Gmail" android:inputType="textVisiblePassword" android:autofillHints="username" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#9AA8A3" android:backgroundTint="#C7F568" />
+<EditText android:id="@+id/memberPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="รหัสผ่าน GeoX" android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#9AA8A3" android:backgroundTint="#C7F568" />
+<CheckBox android:id="@+id/memberRemember" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="จดจำบัญชีในเครื่องนี้" android:textColor="#EFF5F0" android:buttonTint="#C7F568" />
+<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="บันทึกหลังเข้าสู่ระบบสำเร็จ เมื่อจำเป็นต้องเข้าสู่ระบบใหม่ แอปจะกรอกข้อมูลให้ โดยยังต้องตรวจสิทธิ์ตามปกติ" android:textSize="13sp" android:textColor="#9AA8A3" />
+<Button android:id="@+id/memberForget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ลืมบัญชีที่จดจำไว้" android:visibility="gone" />
+<Button android:id="@+id/memberLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="เข้าสู่ระบบ" android:backgroundTint="#C7F568" android:textColor="#101416" />
+<ProgressBar android:id="@+id/memberProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
+<TextView android:id="@+id/memberError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#FFB5B5" android:visibility="gone" />
+<Button android:id="@+id/memberRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="สมัครสมาชิก / จัดการบัญชีบนเว็บ" />
+<Button android:id="@+id/memberLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ออกจากระบบและลืมบัญชี" android:visibility="gone" />
+</LinearLayout></ScrollView>
