diff --git a/app/src/main/java/io/github/phantom/gps/utils/FullLockRelayService.kt b/app/src/main/java/io/github/phantom/gps/utils/FullLockRelayService.kt
new file mode 100644
index 0000000000000000000000000000000000000000..363d32453f64237a503dde1b8cbc63471039b453
--- /dev/null
+++ b/app/src/main/java/io/github/phantom/gps/utils/FullLockRelayService.kt
@@ -0,0 +1,111 @@
+package io.github.phantom.gps.utils
+
+import android.app.Service
+import android.content.Intent
+import android.os.*
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlinx.coroutines.*
+
+/** Bootstrap is Full Lock UID only. A private, revocable capability permits the root relay. */
+class FullLockRelayService : Service() {
+    companion object {
+        const val DESCRIPTOR = "io.github.phantom.gps.FullLockRelay.v1"
+        const val SESSION = "io.github.phantom.gps.LocationSession.v1"
+        const val OPEN = IBinder.FIRST_CALL_TRANSACTION
+        const val SUBMIT = IBinder.FIRST_CALL_TRANSACTION
+        const val KEEP_ALIVE = IBinder.FIRST_CALL_TRANSACTION + 1
+        const val CLOSE = IBinder.FIRST_CALL_TRANSACTION + 2
+        const val LEASE_MS = 15000L
+    }
+    private var active: Session? = null
+    private val maintenanceScope=CoroutineScope(SupervisorJob()+Dispatchers.Main.immediate)
+    private var maintenance:Job?=null
+    private fun maintain(session:Session) {
+        maintenance?.cancel()
+        maintenance=maintenanceScope.launch {
+            while(isActive&&session.valid()) {
+                if(MembershipAccount.isSignedIn(applicationContext))LicenseGuard.performBackgroundCheck(applicationContext)
+                repeat(24) { delay(5000);if(!session.valid())return@launch }
+            }
+        }
+    }
+    private fun ownerUid(): Int = packageManager.getPackageUid(DirectLocationProtocol.CALLER_PACKAGE, 0)
+    private fun requireOwner(): Int {
+        val uid = Binder.getCallingUid()
+        if (uid != ownerUid() || packageManager.getPackagesForUid(uid)?.toSet() != setOf(DirectLocationProtocol.CALLER_PACKAGE))
+            throw SecurityException("Full Lock caller required")
+        return uid
+    }
+    private val gateway = object : Binder() {
+        override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
+            if (code == INTERFACE_TRANSACTION) { reply?.writeString(DESCRIPTOR); return true }
+            if (code != OPEN) return super.onTransact(code, data, reply, flags)
+            data.enforceInterface(DESCRIPTOR)
+            val uid = requireOwner()
+            if (data.readInt() != 1) throw IllegalArgumentException("Unsupported bridge version")
+            val lifetime = data.readStrongBinder() ?: throw IllegalArgumentException("Owner lifetime required")
+            if (data.dataAvail() != 0 || reply == null) throw IllegalArgumentException("Invalid bootstrap")
+            val session = Session(uid, lifetime)
+            synchronized(this@FullLockRelayService) {
+                active?.close()
+                active = session
+                maintain(session)
+            }
+            reply.writeNoException()
+            reply.writeStrongBinder(session)
+            return true
+        }
+    }
+    private inner class Session(val owner: Int, val lifetime: IBinder) : Binder(), IBinder.DeathRecipient {
+        private val live = AtomicBoolean(true)
+        private val lease = RelayLease({ SystemClock.elapsedRealtime() }, LEASE_MS)
+        init { lifetime.linkToDeath(this, 0) }
+        fun valid(): Boolean = live.get() && lifetime.isBinderAlive &&
+            lease.valid() && runCatching { ownerUid() == owner }.getOrDefault(false)
+        fun close() { lease.revoke(); if (live.getAndSet(false)) runCatching { lifetime.unlinkToDeath(this, 0) } }
+        override fun binderDied() { close() }
+        override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
+            if (code == INTERFACE_TRANSACTION) { reply?.writeString(SESSION); return true }
+            data.enforceInterface(SESSION)
+            when (code) {
+                KEEP_ALIVE -> {
+                    if (requireOwner() != owner || !valid()) throw SecurityException("Session expired")
+                    if (!lease.renew()) throw SecurityException("Session expired")
+                }
+                CLOSE -> { if (requireOwner() != owner) throw SecurityException("Session owner required"); close() }
+                SUBMIT -> {
+                    // UID 0 alone grants nothing: this private Binder must first be issued by Full Lock.
+                    if (Binder.getCallingUid() != 0 || !valid()) throw SecurityException("Relay session unavailable")
+                    if (data.dataSize() > 8192) throw IllegalArgumentException("Oversized location request")
+                    val version = data.readInt()
+                    val id = data.readString().orEmpty()
+                    val lat = data.readDouble()
+                    val lng = data.readDouble()
+                    val label = data.readString().orEmpty()
+                    val target = data.readString().orEmpty()
+                    val callback = ResultReceiver.CREATOR.createFromParcel(data)
+                    if (data.dataAvail() != 0) throw IllegalArgumentException("Unexpected request data")
+                    val request = Intent().putExtra("api_version", version).putExtra("request_id", id)
+                        .putExtra("latitude", lat).putExtra("longitude", lng)
+                        .putExtra("label", label).putExtra("target_package", target)
+                    // No disk, license work or Hook wait on the Driver/Binder calling thread.
+                    DirectLocationEngine.submit(applicationContext, request, callback, allowed = { valid() })
+                }
+                else -> return super.onTransact(code, data, reply, flags)
+            }
+            reply?.writeNoException()
+            return true
+        }
+    }
+    override fun onBind(intent: Intent?): IBinder = gateway
+    override fun onUnbind(intent: Intent?): Boolean {
+        maintenance?.cancel()
+        synchronized(this) { active?.close(); active = null }
+        return false
+    }
+    override fun onDestroy() {
+        maintenanceScope.cancel()
+        synchronized(this) { active?.close(); active = null }
+        super.onDestroy()
+    }
+}
diff --git a/app/src/main/java/io/github/phantom/gps/utils/HookDiagnostics.kt b/app/src/main/java/io/github/phantom/gps/utils/HookDiagnostics.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c6f541a698a22ff1e39a54128dac0226c51b8ceb
--- /dev/null
+++ b/app/src/main/java/io/github/phantom/gps/utils/HookDiagnostics.kt
@@ -0,0 +1,56 @@
+package io.github.phantom.gps.utils
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.ResultReceiver
+import androidx.fragment.app.FragmentActivity
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.LifecycleOwner
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import java.util.UUID
+
+/** Read-only targeted diagnostics. Replies never authorize a location action or replace signed lease validation. */
+object HookDiagnostics {
+    fun show(activity:FragmentActivity,target:String) {
+        val handler=Handler(Looper.getMainLooper())
+        val query=UUID.randomUUID().toString()
+        val sharing=if(PrefManager.isHookSharingAvailable)"GeoX: ช่องทางค่าร่วมพร้อม" else "GeoX: ช่องทางค่าร่วม LSPosed ไม่พร้อม (กำลังใช้ private prefs)"
+        var answered=false
+        val states=linkedSetOf<String>()
+        val dialog=MaterialAlertDialogBuilder(activity,io.github.phantom.gps.R.style.ThemeOverlay_GeoX_Dialog).setTitle("ตรวจ Hook: $target")
+            .setMessage(sharing+"\n\nกำลังรอคำตอบจากแอปเป้าหมาย…").setPositiveButton("ปิด",null).create()
+        val observer=object:DefaultLifecycleObserver { override fun onDestroy(owner:LifecycleOwner){dialog.dismiss()} }
+        val timeout=Runnable {
+            if(dialog.isShowing&&!answered)dialog.setMessage("ยังไม่ได้รับคำตอบ\nแอปอาจยังไม่เปิด ไม่อยู่ใน scope หรือยังโหลด Hook รุ่นเก่าที่ไม่รองรับการตรวจนี้\nสถานะนี้ไม่ได้ยืนยันว่าโมดูลปิดอยู่")
+        }
+        val reply=object:ResultReceiver(handler) {
+            override fun onReceiveResult(code:Int,data:Bundle?) {
+                if(!dialog.isShowing||data?.getString("query_id")!=query||data.getString("package")!=target)return
+                answered=true
+                val reason=if(target=="android"&&!data.getBoolean("system_mode_enabled"))"SYSTEM_MODE_OFF"
+                    else if(target=="android"&&!data.getBoolean("system_hooks_ready"))"SYSTEM_HOOKS_NOT_READY" else data.getString("reason").orEmpty()
+                val text=when(reason){
+                    "READY"->"อ่านค่าร่วมและสิทธิ์ผ่าน / คำสั่ง START เปิดอยู่ (ยังไม่ใช่หลักฐานว่าแอปอ่านพิกัดแล้ว)"
+                    "STOPPED"->"อ่านค่าร่วมและสิทธิ์ผ่าน / คำสั่ง START ยังปิดอยู่"
+                    "SNAPSHOT_MISSING"->"Hook โหลดแล้ว แต่ไม่พบค่าการทำงานในไฟล์ร่วม"
+                    "LEASE_MISSING"->"Hook โหลดแล้ว แต่ยังอ่านสิทธิ์สมาชิกไม่ได้"
+                    "LEASE_INVALID"->"Hook ตรวจลายเซ็นหรือโครงสร้างสิทธิ์ไม่ผ่าน"
+                    "BOOT_NOT_READY"->"Hook ยังอ่านหมายเลขรอบเปิดเครื่องไม่ได้"
+                    "BOOT_MISMATCH"->"สิทธิ์ใน Hook เป็นของรอบเปิดเครื่องเก่า"
+                    "LEASE_TIME_INVALID"->"สิทธิ์ใน Hook หมดช่วงเวลา หรือเวลาเครื่องไม่ตรง"
+                    "SYSTEM_MODE_OFF"->"Hook โหลดในระบบ แต่ Advanced hook ยังปิดอยู่"
+                    "SYSTEM_HOOKS_NOT_READY"->"ตัวรับโหลดแล้ว แต่ system hook ยังติดตั้งไม่ครบ"
+                    else->"ตรวจ Hook ไม่สำเร็จ: $reason"
+                }
+                states.add("Hook ${data.getString("version","?")}: $text")
+                dialog.setMessage(sharing+"\n\n"+states.joinToString("\n\n"))
+            }
+        }
+        activity.lifecycle.addObserver(observer)
+        dialog.setOnDismissListener {handler.removeCallbacks(timeout);activity.lifecycle.removeObserver(observer)}
+        dialog.show()
+        runCatching { LocationRefresh.diagnose(activity,target,query,reply) }.onFailure {dialog.setMessage("ส่งคำขอตรวจสอบไม่ได้")}
+        handler.postDelayed(timeout,8000)
+    }
+}
