@@ -0,0 +1,68 @@
+package io.github.phantom.gps.test
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.functions.FirebaseFunctions
+import com.google.android.gms.tasks.Tasks
+import io.github.phantom.gps.utils.*
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.util.concurrent.TimeUnit
+import java.security.KeyFactory
+import java.security.Signature
+import java.security.spec.X509EncodedKeySpec
+import java.util.Base64
+
+@RunWith(AndroidJUnit4::class)
+class MembershipDeviceTest {
+ private val context get()=InstrumentationRegistry.getInstrumentation().targetContext
+ private fun emulatorExpiry(uid:String,expiry:Long) {
+  check(com.google.firebase.FirebaseApp.getInstance().options.projectId=="demo-phantom-gps")
+  val url=java.net.URL("http://127.0.0.1:8080/v1/projects/demo-phantom-gps/databases/(default)/documents/members/$uid?updateMask.fieldPaths=expiresAtMs")
+  val c=url.openConnection() as java.net.HttpURLConnection
+  c.requestMethod="PATCH";c.connectTimeout=5000;c.readTimeout=5000;c.doOutput=true
+  c.setRequestProperty("Authorization","Bearer owner");c.setRequestProperty("Content-Type","application/json")
+  c.outputStream.use { it.write("{\"fields\":{\"expiresAtMs\":{\"integerValue\":\"$expiry\"}}}".toByteArray()) }
+  check(c.responseCode==200);c.disconnect()
+ }
+ private fun call(name:String,data:Map<String,Any> = emptyMap()):Map<*,*> = Tasks.await(FirebaseFunctions.getInstance("asia-southeast1").getHttpsCallable(name).call(data),30,TimeUnit.SECONDS).data as Map<*,*>
+ @Test fun physicalKeystoreAndMembershipLifecycle() = runBlocking {
+  assertTrue(AppIntegrity.isSelfValid(context))
+  val key=KeyFactory.getInstance("EC").generatePublic(X509EncodedKeySpec(Base64.getDecoder().decode(DeviceIdProvider.publicKeyBase64())))
+  val text="physical-device-proof-fixture"
+  assertTrue(Signature.getInstance("SHA256withECDSA").run { initVerify(key);update(text.toByteArray());verify(Base64.getDecoder().decode(DeviceIdProvider.signChallenge(text))) })
+  MembershipAccount.login(context,"android_probe","LocalMemberPassword123!")
+  try {
+   assertTrue(MembershipAccount.isSignedIn(context));assertTrue(MembershipLease.valid(context))
+   val latitude=13.7563123456789
+   val longitude=100.5018123456789
+   assertTrue(LocationController.applyImmediately(context,latitude,longitude,"Local fixture"))
+   assertEquals(java.lang.Double.doubleToLongBits(latitude),java.lang.Double.doubleToLongBits(PrefManager.getLat))
+   assertEquals(java.lang.Double.doubleToLongBits(longitude),java.lang.Double.doubleToLongBits(PrefManager.getLng))
+   LocationController.stop(context)
+   val originalSession=MembershipAccount.sessionId(context)
+   val profile=call("memberProfile")
+   assertTrue((profile["expiresAtMs"] as Number).toLong()-(profile["firstLoginAtMs"] as Number).toLong()>=7L*86400000L)
+   MembershipAccount.renew(context)
+   assertEquals(originalSession,MembershipAccount.sessionId(context));assertTrue(MembershipLease.valid(context))
+   try { call("adminMemberIdentity");fail("Ordinary member obtained admin rights") } catch(e:java.util.concurrent.ExecutionException) { assertTrue(e.cause is com.google.firebase.functions.FirebaseFunctionsException) }
+   MembershipAccount.login(context,"android_probe","LocalMemberPassword123!")
+   assertNotEquals(originalSession,MembershipAccount.sessionId(context));assertTrue(MembershipLease.valid(context))
+   assertEquals(profile["expiresAtMs"],call("memberProfile")["expiresAtMs"])
+   val uid=FirebaseAuth.getInstance().currentUser!!.uid
+   val expiry=(profile["expiresAtMs"] as Number).toLong()
+   try {
+    emulatorExpiry(uid,System.currentTimeMillis()-1000)
+    LicenseGuard.performBackgroundCheck(context)
+    assertTrue(LicenseStore.isLocked(context));assertFalse(MembershipLease.valid(context))
+    assertFalse(LocationController.applyImmediately(context,latitude,longitude,"Expired fixture"))
+   } finally { emulatorExpiry(uid,expiry) }
+   LicenseGuard.performBackgroundCheck(context)
+   assertFalse(LicenseStore.isLocked(context));assertTrue(MembershipLease.valid(context))
+  } finally { MembershipAccount.logout(context) }
+  assertFalse(MembershipAccount.isSignedIn(context));assertFalse(MembershipLease.valid(context))
+ }
+}
