@@ -0,0 +1,70 @@
+package io.github.phantom.gps.utils
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.ProcessLifecycleOwner
+import io.github.phantom.gps.ui.ActivationActivity
+import io.github.phantom.gps.ui.LockedActivity
+import kotlinx.coroutines.*
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Account membership replaces activation codes. Server-signed leases gate all critical work. */
+object LicenseGuard {
+    private val scope=CoroutineScope(SupervisorJob()+Dispatchers.Main.immediate)
+    private val mutex=Mutex()
+    @Deprecated("Register/login with the membership account")
+    fun activate(context: Context, activationCode: String, onResult: (ActivationResult)->Unit) { onResult(ActivationResult(false,"กรุณาเข้าสู่ระบบด้วยบัญชีสมาชิก")) }
+    fun onAppForeground(context: Context) {
+        if(!MembershipAccount.isSignedIn(context)) return
+        startHeartbeat(context)
+        verifyNowForeground(context)
+    }
+    fun startHeartbeat(context: Context) { runCatching { ContextCompat.startForegroundService(context,Intent(context,MembershipHeartbeatService::class.java)) } }
+    fun onAppBackground()=Unit
+    fun verifyNowForeground(context: Context,onResult:((Boolean)->Unit)?=null) { scope.launch { val result=check(context,true);onResult?.invoke(result) } }
+    fun verifyNowForRetry(context: Context,onResult:((Boolean)->Unit)?=null)=verifyNowForeground(context,onResult)
+    suspend fun performBackgroundCheck(context: Context):Boolean { check(context,false);return true }
+    private suspend fun check(context: Context,launchUi: Boolean):Boolean = mutex.withLock {
+        if(!MembershipAccount.isSignedIn(context)) return@withLock false
+        try { MembershipAccount.renew(context);unlock(context);true }
+        catch(e:Exception) {
+            if(e is CancellationException)throw e
+            val permanent=MembershipAccount.errorCode(e) in setOf("SESSION_REPLACED","MEMBERSHIP_EXPIRED","MEMBER_DISABLED","MEMBER_NOT_FOUND","LOGIN_REQUIRED","UNAUTHENTICATED")
+            if(!permanent && MembershipLease.valid(context))return@withLock true
+            PrefManager.membershipLease=""
+            lock(context,MembershipAccount.errorCode(e),!permanent,launchUi);false
+        }
+    }
+    fun isLocallyAllowedForCriticalAction(context: Context):Boolean = AppIntegrity.isSelfValid(context) && MembershipAccount.isSignedIn(context) && !LicenseStore.isLocked(context) && MembershipLease.valid(context)
+    fun runCriticalActionIfAllowed(context: Context,action:()->Unit):Boolean {
+        if(isLocallyAllowedForCriticalAction(context)){action();return true}
+        if(context is Activity || isForeground())routeToRequiredScreen(context)
+        return false
+    }
+    fun routeToRequiredScreen(context: Context):Boolean {
+        val activity=if(!MembershipAccount.isSignedIn(context))ActivationActivity::class.java else if(!isLocallyAllowedForCriticalAction(context))LockedActivity::class.java else return false
+        runCatching { context.startActivity(Intent(context,activity).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)) };return true
+    }
+    fun clearLicenseAndDeactivate(context: Context) { LicenseWorkScheduler.cancel(context);MembershipAccount.logout(context) }
+    fun unlock(context: Context) { LicenseStore.setLocked(context,false,"",false) }
+    fun lockRetryable(context: Context,reason:String,launchUi:Boolean=true)=lock(context,reason,true,launchUi)
+    fun lockPermanent(context: Context,reason:String,launchUi:Boolean=true)=lock(context,reason,false,launchUi)
+    private fun lock(context: Context,reason:String,retryable:Boolean,launchUi:Boolean) {
+        LicenseStore.setLocked(context,true,reason,retryable)
+        runCatching{LocationController.stop(context)}
+        runCatching{context.stopService(Intent(context,ClipboardMonitorService::class.java))}
+        if(launchUi&&isForeground())routeToRequiredScreen(context)
+    }
+    fun getUserFacingReason(context: Context,reason:String):String = when(reason) {
+        "MEMBERSHIP_EXPIRED"->"สิทธิ์ 7 วันหมดอายุ กรุณาติดต่อแอดมินเพื่อต่ออายุ"
+        "SESSION_REPLACED"->"บัญชีนี้ถูกใช้งานบนเครื่องอื่นแล้ว"
+        "MEMBER_DISABLED"->"บัญชีถูกระงับ กรุณาติดต่อแอดมิน"
+        else->"กรุณาเชื่อมต่ออินเทอร์เน็ตและตรวจสิทธิ์อีกครั้ง"
+    }
+    private fun isForeground()=ProcessLifecycleOwner.get().lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)
+    data class ActivationResult(val success:Boolean,val errorMessage:String?)
+}
diff --git a/app/src/full/java/io/github/phantom/gps/utils/LicensePrefs.kt b/app/src/full/java/io/github/phantom/gps/utils/LicensePrefs.kt
new file mode 100644
index 0000000000000000000000000000000000000000..792c02a5d8833d064d0fec2e4ed012f76e5afc70
--- /dev/null
+++ b/app/src/full/java/io/github/phantom/gps/utils/LicensePrefs.kt
@@ -0,0 +1,136 @@
+package io.github.phantom.gps.utils
+
+import android.content.Context
+
+class LicensePrefs(ctx: Context) {
+    private val sp = ctx.applicationContext.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
+
+    fun isActivated(): Boolean = sp.getBoolean(KEY_ACTIVATED, false)
+
+    fun setActivated(value: Boolean) {
+        sp.edit().putBoolean(KEY_ACTIVATED, value).apply()
+    }
+
+    fun getLicenseId(): String = sp.getString(KEY_LICENSE_ID, "").orEmpty()
+
+    fun setLicenseId(value: String) {
+        sp.edit().putString(KEY_LICENSE_ID, value).apply()
+    }
+
+    fun getLicenseSecret(): String {
+        val encrypted = sp.getString(KEY_LICENSE_SECRET_ENCRYPTED, "").orEmpty()
+        if (encrypted.isBlank()) {
+            return ""
+        }
+        return LicenseSecretCipher.decryptOrNull(encrypted).orEmpty()
+    }
+
+    fun setLicenseSecret(value: String) {
+        val encrypted = if (value.isBlank()) "" else LicenseSecretCipher.encrypt(value)
+        sp.edit().putString(KEY_LICENSE_SECRET_ENCRYPTED, encrypted).apply()
+    }
+
+    fun getDeviceId(): String = sp.getString(KEY_DEVICE_ID, "").orEmpty()
+
+    fun setDeviceId(value: String) {
+        sp.edit().putString(KEY_DEVICE_ID, value).apply()
+    }
+
+    fun isLocked(): Boolean = sp.getBoolean(KEY_LOCKED, false)
+
+    fun setLocked(locked: Boolean) {
+        sp.edit().putBoolean(KEY_LOCKED, locked).apply()
+    }
+
+    fun getLockReason(): String = sp.getString(KEY_LOCK_REASON, "").orEmpty()
+
+    fun setLockReason(reason: String) {
+        sp.edit().putString(KEY_LOCK_REASON, reason).apply()
+    }
+
+    fun isLockRetryable(): Boolean = sp.getBoolean(KEY_LOCK_RETRYABLE, false)
+
+    fun setLockRetryable(value: Boolean) {
+        sp.edit().putBoolean(KEY_LOCK_RETRYABLE, value).apply()
+    }
+
+    fun getLastLicenseCheckAt(): Long = sp.getLong(KEY_LAST_LICENSE_CHECK_AT, 0L)
+
+    fun setLastLicenseCheckAt(value: Long) {
+        sp.edit().putLong(KEY_LAST_LICENSE_CHECK_AT, value).apply()
+    }
+
+    fun getNextCheckSeconds(): Long = sp.getLong(KEY_NEXT_CHECK_SECONDS, DEFAULT_NEXT_CHECK_SECONDS)
+
+    fun setNextCheckSeconds(value: Long) {
+        sp.edit().putLong(KEY_NEXT_CHECK_SECONDS, normalizeNextCheckSeconds(value)).apply()
+    }
+
+    fun clearLicense() {
+        sp.edit()
+            .remove(KEY_ACTIVATED)
+            .remove(KEY_LICENSE_ID)
+            .remove(KEY_LICENSE_SECRET_ENCRYPTED)
+            .remove(KEY_DEVICE_ID)
+            .remove(KEY_LAST_LICENSE_CHECK_AT)
+            .remove(KEY_NEXT_CHECK_SECONDS)
+            .remove(KEY_LOCKED)
+            .remove(KEY_LOCK_REASON)
+            .remove(KEY_LOCK_RETRYABLE)
+            .commit()
+    }
+
+    fun saveActivatedLicense(
+        licenseId: String,
+        licenseSecret: String,
+        deviceId: String,
+        nextCheckSeconds: Long
+    ) {
+        val encrypted = if (licenseSecret.isBlank()) "" else LicenseSecretCipher.encrypt(licenseSecret)
+        sp.edit()
+            .putBoolean(KEY_ACTIVATED, true)
+            .putString(KEY_LICENSE_ID, licenseId)
+            .putString(KEY_LICENSE_SECRET_ENCRYPTED, encrypted)
+            .putString(KEY_DEVICE_ID, deviceId)
+            .putLong(KEY_LAST_LICENSE_CHECK_AT, System.currentTimeMillis())
+            .putLong(KEY_NEXT_CHECK_SECONDS, normalizeNextCheckSeconds(nextCheckSeconds))
+            .putBoolean(KEY_LOCKED, false)
+            .putString(KEY_LOCK_REASON, "")
+            .putBoolean(KEY_LOCK_RETRYABLE, false)
+            .commit()
+    }
+
+    fun updateLastSuccessfulCheck(nextCheckSeconds: Long) {
+        sp.edit()
+            .putLong(KEY_LAST_LICENSE_CHECK_AT, System.currentTimeMillis())
+            .putLong(KEY_NEXT_CHECK_SECONDS, normalizeNextCheckSeconds(nextCheckSeconds))
+            .commit()
+    }
+
+    fun setLockState(locked: Boolean, reason: String, retryable: Boolean) {
+        sp.edit()
+            .putBoolean(KEY_LOCKED, locked)
+            .putString(KEY_LOCK_REASON, if (locked) reason else "")
+            .putBoolean(KEY_LOCK_RETRYABLE, locked && retryable)
+            .commit()
+    }
+
+    companion object {
+        const val DEFAULT_NEXT_CHECK_SECONDS = 21600L
+
+        private const val PREF_NAME = "phantom_gps_license_guard"
+        private const val KEY_ACTIVATED = "activated"
+        private const val KEY_LICENSE_ID = "license_id"
+        private const val KEY_LICENSE_SECRET_ENCRYPTED = "license_secret_encrypted"
+        private const val KEY_DEVICE_ID = "device_id"
+        private const val KEY_LOCKED = "locked"
+        private const val KEY_LOCK_REASON = "lock_reason"
+        private const val KEY_LOCK_RETRYABLE = "lock_retryable"
+        private const val KEY_LAST_LICENSE_CHECK_AT = "last_license_check_at"
+        private const val KEY_NEXT_CHECK_SECONDS = "next_check_seconds"
+
+        fun normalizeNextCheckSeconds(value: Long): Long {
+            return if (value > 0L) value else DEFAULT_NEXT_CHECK_SECONDS
+        }
+    }
+}
diff --git a/app/src/full/java/io/github/phantom/gps/utils/LicenseSecretCipher.kt b/app/src/full/java/io/github/phantom/gps/utils/LicenseSecretCipher.kt
