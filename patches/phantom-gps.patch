@@ -0,0 +1,33 @@
+package io.github.phantom.gps.utils
+
+import android.app.Service
+import android.app.NotificationManager
+import android.content.Intent
+import android.os.IBinder
+import kotlinx.coroutines.*
+
+/** Runs only while the user-selected location is active. Membership has no standalone ongoing card. */
+class MembershipHeartbeatService:Service() {
+    companion object { @Volatile var running=false; private set }
+    private val scope=CoroutineScope(SupervisorJob()+Dispatchers.Main.immediate)
+    private var job:Job?=null
+    override fun onStartCommand(intent:Intent?,flags:Int,startId:Int):Int {
+        if(!AppIntegrity.isSelfValid(this)||!LocationNoticePolicy.needsActiveService(MembershipAccount.isSignedIn(this),PrefManager.isStarted)){stopSelf();return START_NOT_STICKY}
+        if(job?.isActive==true)return START_STICKY
+        running=true
+        getSystemService(NotificationManager::class.java).cancel(141)
+        getSystemService(NotificationManager::class.java).cancel(NotificationsChannel.NOTIFICATION_ID_CLIPBOARD)
+        startForeground(NotificationsChannel.NOTIFICATION_ID_LOCATION,LocationNotification.build(this))
+        job=scope.launch {
+            if(!MembershipLease.valid(this@MembershipHeartbeatService)&&!LicenseGuard.performBackgroundCheck(this@MembershipHeartbeatService)){stopSelf();return@launch}
+            while(isActive&&PrefManager.isStarted&&MembershipAccount.isSignedIn(this@MembershipHeartbeatService)) {
+                delay(120000)
+                if(!LicenseGuard.performBackgroundCheck(this@MembershipHeartbeatService))break
+            }
+            stopSelf()
+        }
+        return START_STICKY
+    }
+    override fun onBind(intent:Intent?):IBinder?=null
+    override fun onDestroy(){running=false;scope.cancel();stopForeground(STOP_FOREGROUND_DETACH);LocationNotification.stopped(this);super.onDestroy()}
+}
diff --git a/app/src/full/java/io/github/phantom/gps/utils/MembershipStatusNotification.kt b/app/src/full/java/io/github/phantom/gps/utils/MembershipStatusNotification.kt
