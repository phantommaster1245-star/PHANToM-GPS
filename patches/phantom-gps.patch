@@ -0,0 +1,33 @@
+package io.github.phantom.gps.ui
+
+import android.app.Application
+import androidx.lifecycle.*
+import io.github.phantom.gps.utils.*
+import kotlinx.coroutines.launch
+
+class MembershipLoginViewModel(app:Application):AndroidViewModel(app) {
+    data class State(val busy:Boolean=false,val success:Boolean=false,val error:String="",val notice:String="")
+    private val state=MutableLiveData(State())
+    val uiState:LiveData<State> = state
+    private var checked=false
+    fun checkExisting() {
+        if(checked)return;checked=true
+        if(!MembershipAccount.isSignedIn(getApplication()))return
+        state.value=State(busy=true)
+        LicenseGuard.verifyNowForeground(getApplication()){ok->state.value=State(success=ok,error=if(ok)"" else "ตรวจสิทธิ์ไม่สำเร็จ กรุณาลองใหม่หรือเข้าสู่ระบบอีกครั้ง")}
+    }
+    fun login(username:String,password:String,remember:Boolean) {
+        if(state.value?.busy==true)return
+        if(username.isBlank()||password.isBlank()){state.value=State(error="กรุณากรอกชื่อผู้ใช้และรหัสผ่าน");return}
+        state.value=State(busy=true)
+        viewModelScope.launch {
+            try{
+                MembershipAccount.login(getApplication(),username,password)
+                val remembered=runCatching{RememberedLoginStore(getApplication()).save(username,password,remember)}.isSuccess
+                LicenseGuard.startHeartbeat(getApplication())
+                state.value=State(success=true,notice=if(remembered)"" else "เข้าสู่ระบบสำเร็จ แต่จดจำบัญชีไม่สำเร็จ กรุณาลองเปิดตัวเลือกนี้ใหม่ภายหลัง")
+            }
+            catch(e:Exception){if(e is kotlinx.coroutines.CancellationException)throw e;state.value=State(error=MembershipAccount.message(e))}
+        }
+    }
+}
