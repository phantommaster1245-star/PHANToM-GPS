@@ -0,0 +1,33 @@
+package io.github.phantom.gps.utils
+
+import android.content.Context
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import java.util.concurrent.TimeUnit
+
+object LicenseWorkScheduler {
+    private const val WORK_NAME = "license_check"
+    private const val REPEAT_HOURS = 6L
+    private const val FLEX_HOURS = 1L
+
+    @Suppress("UNUSED_PARAMETER")
+    fun schedule(context: Context, nextCheckSeconds: Long = LicensePrefs.DEFAULT_NEXT_CHECK_SECONDS) {
+        val request = PeriodicWorkRequestBuilder<LicenseCheckWorker>(
+            REPEAT_HOURS,
+            TimeUnit.HOURS,
+            FLEX_HOURS,
+            TimeUnit.HOURS
+        ).build()
+
+        WorkManager.getInstance(context).enqueueUniquePeriodicWork(
+            WORK_NAME,
+            ExistingPeriodicWorkPolicy.UPDATE,
+            request
+        )
+    }
+
+    fun cancel(context: Context) {
+        WorkManager.getInstance(context).cancelUniqueWork(WORK_NAME)
+    }
+}
diff --git a/app/src/full/java/io/github/phantom/gps/utils/MembershipAccount.kt b/app/src/full/java/io/github/phantom/gps/utils/MembershipAccount.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c4664b31689a79725ff3bb89569d6e81f27da5c4
--- /dev/null
+++ b/app/src/full/java/io/github/phantom/gps/utils/MembershipAccount.kt
@@ -0,0 +1,87 @@
+package io.github.phantom.gps.utils
+
+import android.content.Context
+import android.os.SystemClock
+import com.google.android.gms.tasks.Task
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.functions.FirebaseFunctions
+import com.google.firebase.functions.FirebaseFunctionsException
+import io.github.phantom.gps.BuildConfig
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+object MembershipAccount {
+    private val auth get() = FirebaseAuth.getInstance()
+    private val functions get() = FirebaseFunctions.getInstance("asia-southeast1")
+    private fun prefs(c: Context) = c.getSharedPreferences("phantom_member_account", Context.MODE_PRIVATE)
+    fun sessionId(c: Context) = prefs(c).getString("session", "").orEmpty()
+    fun isSignedIn(c: Context) = auth.currentUser != null && sessionId(c).isNotEmpty()
+    fun username(c: Context) = prefs(c).getString("username", "").orEmpty()
+    fun expiresAt(c: Context) = prefs(c).getLong("expires", 0)
+    private fun input(c: Context): MutableMap<String, Any> = mutableMapOf("deviceId" to DeviceIdProvider.getDeviceId(),
+        "bootCount" to MembershipLease.bootCount(c), "elapsedMs" to SystemClock.elapsedRealtime(), "packageName" to BuildConfig.APPLICATION_ID)
+    suspend fun login(c: Context, username: String, password: String) {
+        check(AppIntegrity.isSelfValid(c))
+        val result = call("memberLogin", mapOf("username" to username.trim(), "password" to password))
+        auth.signInWithEmailAndPassword(result["email"] as? String ?: error("INVALID_RESPONSE"),password).waitFor()
+        try { val opened = call("memberOpenSession", provedInput(c,"open")); save(c, opened)
+            prefs(c).edit().putString("username", username.trim()).commit()
+        } catch (e: Exception) { logout(c); throw e }
+    }
+    suspend fun renew(c: Context) {
+        if (!isSignedIn(c)) throw IllegalStateException("LOGIN_REQUIRED")
+        save(c,call("memberRenewLease",provedInput(c,"renew")))
+    }
+    private suspend fun provedInput(c:Context,operation:String):Map<String,Any> {
+        val data=input(c)
+        val session=if(operation=="renew")sessionId(c) else ""
+        if(operation=="renew")data["sessionId"]=session
+        val challenge=call("memberDeviceChallenge",data+mapOf("operation" to operation,"publicKey" to DeviceIdProvider.publicKeyBase64()))
+        val challengeId=challenge["challengeId"] as? String ?: error("INVALID_RESPONSE")
+        val nonce=challenge["nonce"] as? String ?: error("INVALID_RESPONSE")
+        val message=DeviceProof.message(auth.currentUser?.uid ?: error("LOGIN_REQUIRED"),operation,challengeId,nonce,
+            data["deviceId"] as String,data["bootCount"] as Int,data["elapsedMs"] as Long,session)
+        data["challengeId"]=challengeId
+        data["deviceSignature"]=DeviceIdProvider.signChallenge(message)
+        return data
+    }
+
+    private fun save(c: Context, data: Map<*, *>) {
+        val token=data["lease"] as? String ?: error("INVALID_RESPONSE")
+        val verifier=MembershipLease.verifier
+        require(verifier.isValid(token,System.currentTimeMillis(),SystemClock.elapsedRealtime(),MembershipLease.bootCount(c),DeviceIdProvider.getDeviceId())) { "LEASE_INVALID" }
+        val parsed=verifier.inspect(token) ?: error("LEASE_INVALID")
+        require(parsed.uid==auth.currentUser?.uid && parsed.session==data["sessionId"]) { "LEASE_INVALID" }
+        prefs(c).edit().putString("session",parsed.session).putLong("expires",parsed.membershipExpiresAt).commit()
+        PrefManager.membershipLease=token
+        LicensePrefs(c).setLockState(false,"",false)
+        LocationRefresh.send(c)
+    }
+    fun logout(c: Context) {
+        PrefManager.membershipLease=""
+        prefs(c).edit().clear().commit()
+        auth.signOut()
+        runCatching { LocationController.stop(c) }
+        c.stopService(android.content.Intent(c, MembershipHeartbeatService::class.java))
+        LicensePrefs(c).clearLicense()
+    }
+    fun errorCode(error: Throwable): String = if(error is FirebaseFunctionsException) (error.details as? Map<*, *>)?.get("code")?.toString() ?: error.code.name else error.message.orEmpty()
+    fun message(error: Throwable): String = when(errorCode(error)) {
+        "LOGIN_FAILED", "USERNAME_INVALID" -> "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง"
+        "TOO_MANY_REQUESTS" -> "ลองเข้าสู่ระบบบ่อยเกินไป กรุณารอสักครู่"
+        "MEMBER_NOT_FOUND", "GOOGLE_PASSWORD_REQUIRED" -> "กรุณาสมัครสมาชิกผ่านเว็บไซต์ก่อน"
+        "MEMBERSHIP_EXPIRED" -> "สิทธิ์ใช้งานหมดอายุ กรุณาติดต่อแอดมินเพื่อต่ออายุ"
+        "SESSION_REPLACED" -> "บัญชีนี้เข้าสู่ระบบบนเครื่องอื่นแล้ว"
+        "MEMBER_DISABLED" -> "บัญชีถูกระงับ กรุณาติดต่อแอดมิน"
+        "DEVICE_PROOF_INVALID" -> "ยืนยันเครื่องไม่สำเร็จ กรุณาเข้าสู่ระบบใหม่"
+        "LEASE_INVALID" -> "ตรวจสิทธิ์ไม่สำเร็จ กรุณาตรวจวันเวลาอัตโนมัติของเครื่อง"
+        else -> "เชื่อมต่อระบบสมาชิกไม่สำเร็จ กรุณาลองใหม่"
+    }
+    private suspend fun call(name: String, data: Map<String, Any>): Map<*, *> = functions.getHttpsCallable(name).call(data).waitFor().data as? Map<*, *> ?: error("INVALID_RESPONSE")
+    private suspend fun <T> Task<T>.waitFor(): T = suspendCancellableCoroutine { cont ->
+        addOnSuccessListener { if(cont.isActive) cont.resume(it) }
+        addOnFailureListener { if(cont.isActive) cont.resumeWithException(it) }
+        addOnCanceledListener { cont.cancel() }
+    }
+}
